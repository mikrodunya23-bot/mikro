  "lines": [
    {
      "scene": "baslik",
      "who": "anlatici",
      "text": "Bir varmış, bir yokmuş... Gökyüzünün en minik bulutu Pofi, her gece yıldızları sayarmış.",
      "tag": "[warmly]"
    },
    {
      "scene": "gece",
      "who": "pofi",
      "text": "Bir, iki, üç, dört... Aaa! Bir yıldız eksik!",
      "tag": "[curious]"
    },
    {
      "scene": "dusus",
      "who": "anlatici",
      "text": "O gece, Pırıl adında minicik bir yıldız, gökyüzünden kayıp ormana düşmüş.",
      "tag": "[mysterious]"
    },
    {
      "scene": "orman",
      "who": "piril",
      "text": "Hıı... Evimin yolunu kaybettim. Çok uzaktayım...",
      "tag": "[sad] [sniffles]"
    },
    {
      "scene": "orman",
      "who": "fistik",
      "text": "Hey, ağlama! Ben Fıstık! Sana yardım edeceğim!",
      "tag": "[excited]"
    },
    {
      "scene": "inis",
      "who": "pofi",
      "text": "Ben de geldim! Seni gökyüzüne taşıyabilirim... ama, ben çok küçüğüm.",
      "tag": "[cheerfully]"
    },
    {
      "scene": "inis",
      "who": "fistik",
      "text": "O zaman birlikte deneriz! Herkes tutunsun!",
      "tag": "[determined]"
    },
    {
      "scene": "tirmanis",
      "who": "anlatici",
      "text": "Fıstık ormanın en yüksek ağacına tırmanmış. Pofi de var gücüyle uçmuş, uçmuş...",
      "tag": "[storytelling]"
    },
    {
      "scene": "yukselis",
      "who": "pofi",
      "text": "Hadi! Biraz daha! Neredeyse geldik!",
      "tag": "[effortful] [excited]"
    },
    {
      "scene": "evde",
      "who": "piril",
      "text": "Evimdeyim! Teşekkürler arkadaşlarım! Artık her gece size göz kırpacağım!",
      "tag": "[happy]"
    },
    {
      "scene": "evde",
      "who": "fistik",
      "text": "Küçük olabiliriz...",
      "tag": "[thoughtful]"
    },
    {
      "scene": "evde",
      "who": "pofi",
      "text": "Ama birlikte kocamanız!",
      "tag": "[joyfully] [shouting]"
    },
    {
      "scene": "son",
      "who": "anlatici",
      "text": "Ve o geceden beri, gökyüzünde en çok parlayan yıldız... Pırıl'mış.",
      "tag": "[softly]"
    }
  ],
  "model": "eleven_v3"
